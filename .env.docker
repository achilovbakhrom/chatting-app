# Docker Environment Variables
# Copy this file to .env for Docker Compose

# JWT Secret - CHANGE THIS!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-please-make-it-long-and-random

# OpenAI API Key - Add your key here
OPENAI_API_KEY=your-openai-api-key-here

# Other variables are set in docker-compose.yml
